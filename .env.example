# Cyber Defense Visualization System - Environment Variables

# API Keys (Optional - enhances narration quality)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Falco Configuration (Optional - for real-time Docker monitoring)
FALCO_SOCKET_PATH=/var/run/falco.sock

# Frontend Configuration
FRONTEND_PORT=3000

# Docker Configuration
DOCKER_SOCKET=/var/run/docker.sock
